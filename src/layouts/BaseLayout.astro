---
import '@fontsource-variable/fraunces';
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '~/styles/global.css';

import SEO from '~/components/SEO.astro';
import SkipLink from '~/components/SkipLink.astro';
import Nav from '~/components/Nav.astro';
import Footer from '~/components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  pubDate?: Date;
  navVariant?: 'home' | 'post';
  noindex?: boolean;
}

const {
  title,
  description,
  image,
  type = 'website',
  pubDate,
  navVariant = 'home',
  noindex = false,
} = Astro.props;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0A0A0B" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <SEO
      title={title}
      description={description}
      image={image}
      type={type}
      pubDate={pubDate}
      noindex={noindex}
    />
    <slot name="head" />
  </head>
  <body>
    <div class="brand-strip" aria-hidden="true"></div>
    <SkipLink />
    <Nav variant={navVariant} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      (() => {
        const hints = document.querySelectorAll<HTMLElement>('[data-swipe-hint]');
        if (!hints.length) return;
        if (window.matchMedia('(min-width: 768px)').matches) return;
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

        const nudge = (el: HTMLElement) => {
          if (el.dataset.hinted) return;
          if (el.scrollWidth <= el.clientWidth + 4) return;
          el.dataset.hinted = 'true';
          // Firefox cancels smooth scrolls when scroll-snap-type is mandatory,
          // so temporarily relax it for the duration of the nudge.
          const prevSnap = el.style.scrollSnapType;
          el.style.scrollSnapType = 'none';
          el.scrollTo({ left: 56, behavior: 'smooth' });
          window.setTimeout(() => {
            el.scrollTo({ left: 0, behavior: 'smooth' });
            window.setTimeout(() => {
              el.style.scrollSnapType = prevSnap;
            }, 700);
          }, 600);
        };

        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                nudge(entry.target as HTMLElement);
                observer.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.4 }
        );

        hints.forEach((el) => observer.observe(el));
      })();
    </script>
  </body>
</html>
