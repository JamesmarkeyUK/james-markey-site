---
import { getCountryPins } from '~/data/travels';
import { CONTINENTS, CONTINENT_VIEWBOXES, type Continent } from '~/data/continents';
import { countryShapes } from '~/data/countryShapes';

const VIEW_W = 1000;
const VIEW_H = 500;

function project(lat: number, lon: number) {
  return {
    x: ((lon + 180) / 360) * VIEW_W,
    y: ((90 - lat) / 180) * VIEW_H,
  };
}

const rawPins = await getCountryPins();
const pins = rawPins.map((p) => {
  const { x, y } = project(p.lat, p.lon);
  return {
    ...p,
    x: x + (p.pinOffsetX ?? 0),
    y: y + (p.pinOffsetY ?? 0),
  };
});

// Visited country codes — used to highlight their dots on the base map.
const visitedCodes = new Set(pins.map((p) => p.countryCode));

// Count visited countries per continent
const continentCounts: Record<string, number> = {};
for (const p of pins) {
  if (p.continent) {
    continentCounts[p.continent] = (continentCounts[p.continent] ?? 0) + 1;
  }
}

const continentViewboxes = Object.fromEntries(
  CONTINENTS.map((c) => [c, CONTINENT_VIEWBOXES[c]])
);

// Fixed home / office locations (not travel pins)
const rawBasePins = [
  {
    id: 'guildford',
    label: 'Guildford, Surrey',
    tagline: 'Home · United Kingdom',
    connections: 'UNI SIM HQ · Export Champion',
    population: '~145K city · ~590K borough',
    founded: 'c. 978 AD (first recorded)',
    facts: 'County town of Surrey · 35 mi SW of London · Home to University of Surrey · Norman castle ruins on the high street · River Wey Navigation — one of England\'s first commercial waterways (1653)',
    lat: 51.24, lon: -0.57,
    offsetX: -10, offsetY: 0,
  },
  {
    id: 'laval',
    label: 'Laval, Mayenne',
    tagline: 'Office · Pays de la Loire, France',
    connections: 'HRV Simulation HQ',
    population: '~51K city · ~310K département',
    founded: 'c. 10th century',
    facts: 'Birthplace of post-impressionist painter Henri Rousseau (1844) · 12th-century Château de Laval overlooks the Mayenne river · Capital of the Mayenne département · ~280 km SW of Paris · Known for its medieval old town',
    lat: 48.07, lon: -0.77,
    offsetX: 8, offsetY: 0,
  },
];
const basePins = rawBasePins.map((p) => {
  const { x, y } = project(p.lat, p.lon);
  return { ...p, x: x + p.offsetX, y: y + p.offsetY };
});
---

<div data-fullscreen-root class="fullscreen-root">
<div class="world-map-wrapper space-y-3" data-world-map>
  <!-- Continent filter chips -->
  <div class="flex flex-wrap gap-2" data-continent-filters>
    <button
      type="button"
      class="continent-chip active"
      data-continent="all"
      data-viewbox=""
    >
      All <span class="chip-count">({pins.length})</span>
    </button>
    {CONTINENTS.map((c) => {
      const count = continentCounts[c] ?? 0;
      const vb = CONTINENT_VIEWBOXES[c];
      return (
        <button
          type="button"
          class="continent-chip"
          data-continent={c}
          data-viewbox={vb.join(',')}
        >
          {c} <span class="chip-count">({count})</span>
        </button>
      );
    })}
  </div>

  <!-- Map container -->
  <div class="map-container relative aspect-[2/1] w-full overflow-hidden rounded-lg border border-paper-50/10 bg-ink-900" data-map-container>
    <svg
      viewBox={`0 0 ${VIEW_W} ${VIEW_H}`}
      preserveAspectRatio="xMidYMid meet"
      class="absolute inset-0 h-full w-full touch-none select-none"
      role="img"
      aria-label="World map highlighting countries James has visited"
      data-svg
    >
      <defs>
        <!-- Dim dots for unvisited land -->
        <pattern id="land-dots" width="9" height="9" patternUnits="userSpaceOnUse">
          <circle cx="4.5" cy="4.5" r="1.15" fill="#FAFAF7" fill-opacity="0.26" />
        </pattern>
        <!-- Bright dots that softly colour in each visited country -->
        <pattern id="land-dots-visited" width="9" height="9" patternUnits="userSpaceOnUse">
          <circle cx="4.5" cy="4.5" r="1.6" fill="#FFFFFF" fill-opacity="0.95" />
        </pattern>
      </defs>

      <!-- Dotted-geography base map. Visited countries get bright dots so
           their boundaries read without drawing any outline. -->
      <g class="land">
        {countryShapes.map((s) => (
          <path
            d={s.d}
            fill={visitedCodes.has(s.code) ? 'url(#land-dots-visited)' : 'url(#land-dots)'}
          />
        ))}
      </g>

      <g class="pins">
        {
          pins.map((pin) => (
            <g
              class="pin cursor-pointer"
              data-pin-id={pin.id}
              data-country={pin.country}
              data-continent={pin.continent}
              data-capital={pin.capital}
              data-capital-pop={pin.capitalPop}
              data-country-pop={pin.countryPop}
              data-leader={pin.curated?.leader ?? ''}
              data-leader-title={pin.curated?.leaderTitle ?? ''}
              data-cities={pin.cities.join(', ')}
              data-trip-count={String(pin.tripCount)}
              data-first-visit={pin.firstVisit}
              data-last-visit={pin.lastVisit}
              data-pin-x={pin.x}
              data-pin-y={pin.y}
              transform={`translate(${pin.x}, ${pin.y})`}
              tabindex="0"
              role="button"
              aria-label={`${pin.country} — click for details`}
            >
              <circle class="pin-halo" r="11" />
              <circle class="pin-ring" r="6" />
              <circle class="pin-dot" r="3" />
              <circle class="sparkle" cx="11" cy="-7" r="1" />
              <circle class="sparkle" cx="-9" cy="-10" r="1.3" />
              <circle class="sparkle" cx="-12" cy="5" r="0.9" />
              <circle class="sparkle" cx="9" cy="10" r="1.1" />
              <circle class="sparkle" cx="0" cy="-13" r="0.8" />
              <title>{pin.country}</title>
            </g>
          ))
        }
      </g>

      <g class="base-pins">
        {basePins.map((bp) => (
          <g
            class="base-pin cursor-pointer"
            data-base-id={bp.id}
            data-base-label={bp.label}
            data-base-tagline={bp.tagline}
            data-base-connections={bp.connections}
            data-base-population={bp.population}
            data-base-founded={bp.founded}
            data-base-facts={bp.facts}
            transform={`translate(${bp.x}, ${bp.y})`}
            tabindex="0"
            role="button"
            aria-label={`${bp.label} — click for details`}
          >
            <circle class="base-halo" r="10" />
            <circle class="base-ring" r="5.5" />
            <circle class="base-dot" r="2.5" />
            <title>{bp.label}</title>
          </g>
        ))}
      </g>
    </svg>

    <!-- Visited-country count, superimposed on the map overview -->
    <div class="map-count" aria-hidden="true">
      <span class="map-count-num">{pins.length}.</span>
      <span class="map-count-label">countries visited</span>
    </div>

    <!-- A discreet hello, world -->
    <span class="hello-world" aria-hidden="true">hello, world</span>

    <!-- Zoom controls -->
    <div class="zoom-controls absolute bottom-2 right-2 flex flex-col gap-1">
      <!-- Fullscreen toggle — mobile only -->
      <button type="button" class="zoom-btn sm:hidden" data-fullscreen-btn aria-label="Enter fullscreen">
        <svg class="fullscreen-icon-expand" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M1 5V1h4M9 1h4v4M13 9v4H9M5 13H1V9" />
        </svg>
        <svg class="fullscreen-icon-compress" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none">
          <path d="M5 1v4H1M9 1v4h4M9 13v-4h4M5 13v-4H1" />
        </svg>
      </button>
      <button type="button" class="zoom-btn" data-zoom="in" aria-label="Zoom in">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M7 2v10M2 7h10" />
        </svg>
      </button>
      <button type="button" class="zoom-btn" data-zoom="reset" aria-label="Reset view" title="Reset">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 7a4 4 0 1 0 4-4 4 4 0 0 1-4 4" /><path d="M3 3v4h4" />
        </svg>
      </button>
      <button type="button" class="zoom-btn" data-zoom="out" aria-label="Zoom out">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M2 7h10" />
        </svg>
      </button>
    </div>

  </div>
</div>

<!-- Detail panel: fixed-positioned so it escapes overflow-hidden, layered above everything -->
<div
  class="detail-panel"
  data-detail-panel
  role="dialog"
  aria-live="polite"
>
  <div class="detail-panel-inner">
    <div class="flex items-start justify-between gap-2">
      <h3 class="font-display text-base font-semibold leading-tight text-paper-50" data-detail-country></h3>
      <button
        type="button"
        class="-mr-1 -mt-1 shrink-0 rounded p-1 text-paper-50/50 hover:text-accent"
        aria-label="Close"
        data-detail-close
      >
        <svg width="12" height="12" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M2 2 L12 12 M12 2 L2 12" />
        </svg>
      </button>
    </div>
    <p class="mt-0.5 font-mono text-[10px] uppercase tracking-[0.14em] text-accent" data-detail-continent></p>
    <dl class="mt-3 flex flex-col gap-y-2.5 text-xs">
      <div data-detail-capital-row>
        <dt class="font-mono uppercase tracking-[0.14em] text-paper-50/50">Capital</dt>
        <dd class="mt-0.5 text-paper-50" data-detail-capital></dd>
      </div>
      <div data-detail-capital-pop-row>
        <dt class="font-mono uppercase tracking-[0.14em] text-paper-50/50">Capital pop.</dt>
        <dd class="mt-0.5 text-paper-50" data-detail-capital-pop></dd>
      </div>
      <div data-detail-country-pop-row>
        <dt class="font-mono uppercase tracking-[0.14em] text-paper-50/50">Country pop.</dt>
        <dd class="mt-0.5 text-paper-50" data-detail-country-pop></dd>
      </div>
      <div data-detail-leader-row class="hidden">
        <dt class="font-mono uppercase tracking-[0.14em] text-paper-50/50" data-detail-leader-title></dt>
        <dd class="mt-0.5 text-paper-50" data-detail-leader></dd>
      </div>
      <div data-detail-cities-row>
        <dt class="font-mono uppercase tracking-[0.14em] text-paper-50/50">Cities visited</dt>
        <dd class="mt-0.5 text-paper-50" data-detail-cities></dd>
      </div>
      <div data-detail-trips-row>
        <dt class="font-mono uppercase tracking-[0.14em] text-paper-50/50">Trips</dt>
        <dd class="mt-0.5 text-paper-50" data-detail-trips></dd>
      </div>
      <div data-detail-last-row>
        <dt class="font-mono uppercase tracking-[0.14em] text-paper-50/50">Last visit</dt>
        <dd class="mt-0.5 text-paper-50" data-detail-last></dd>
      </div>
      <div data-detail-population-row class="hidden">
        <dt class="font-mono uppercase tracking-[0.14em] text-paper-50/50">Population</dt>
        <dd class="mt-0.5 text-paper-50" data-detail-population></dd>
      </div>
      <div data-detail-founded-row class="hidden">
        <dt class="font-mono uppercase tracking-[0.14em] text-paper-50/50">Founded</dt>
        <dd class="mt-0.5 text-paper-50" data-detail-founded></dd>
      </div>
      <div data-detail-facts-row class="hidden">
        <dt class="font-mono uppercase tracking-[0.14em] text-paper-50/50">Notes</dt>
        <dd class="mt-0.5 text-paper-50 leading-relaxed" data-detail-facts></dd>
      </div>
    </dl>
  </div>
</div>
</div>

<style>
  /* Continent chips */
  .continent-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.25rem 0.65rem;
    border-radius: 9999px;
    border: 1px solid rgba(250, 250, 247, 0.15);
    background: transparent;
    color: rgba(250, 250, 247, 0.55);
    font-family: ui-monospace, monospace;
    font-size: 0.65rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    cursor: pointer;
    transition: color 150ms ease, border-color 150ms ease, background 150ms ease;
  }
  .continent-chip:hover {
    color: rgba(250, 250, 247, 0.9);
    border-color: rgba(250, 250, 247, 0.3);
  }
  .continent-chip.active {
    background: #F5A524;
    border-color: #F5A524;
    color: #0a0a0a;
  }
  .chip-count {
    opacity: 0.7;
  }
  .continent-chip.active .chip-count {
    opacity: 0.8;
  }

  /* Zoom buttons */
  .zoom-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 0.375rem;
    border: 1px solid rgba(250, 250, 247, 0.15);
    background: rgba(10, 10, 11, 0.7);
    color: rgba(250, 250, 247, 0.6);
    backdrop-filter: blur(4px);
    cursor: pointer;
    transition: color 120ms ease, background 120ms ease;
  }
  .zoom-btn:hover {
    color: #F5A524;
    background: rgba(10, 10, 11, 0.9);
  }

  /* Fullscreen root */
  .fullscreen-root {
    display: contents;
  }

  /* Map in fullscreen mode */
  :fullscreen .map-container,
  :-webkit-full-screen .map-container {
    aspect-ratio: unset !important;
    width: 100%;
    height: 100%;
    border-radius: 0 !important;
    border: none !important;
  }
  :fullscreen .world-map-wrapper,
  :-webkit-full-screen .world-map-wrapper {
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  :fullscreen,
  :-webkit-full-screen {
    background: #0a0a0b;
  }
  :fullscreen .flex.flex-wrap.gap-2,
  :-webkit-full-screen .flex.flex-wrap.gap-2 {
    display: none;
  }

  /* Pseudo-fullscreen fallback — used when the native Fullscreen API isn't
     available (mobile Safari) or is rejected. Mirrors the native styling. */
  :global(html.map-fs-lock),
  :global(html.map-fs-lock body) {
    overflow: hidden;
  }
  .fullscreen-root.is-pseudo-fs {
    display: block;
    position: fixed;
    inset: 0;
    z-index: 9998;
    background: #0a0a0b;
  }
  .fullscreen-root.is-pseudo-fs .world-map-wrapper {
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  .fullscreen-root.is-pseudo-fs .map-container {
    flex: 1;
    aspect-ratio: unset !important;
    width: 100%;
    height: 100%;
    border-radius: 0 !important;
    border: none !important;
  }
  .fullscreen-root.is-pseudo-fs .flex.flex-wrap.gap-2 {
    display: none;
  }

  /* Detail panel — fixed positioned, above everything */
  .detail-panel {
    display: none;
    position: fixed;
    z-index: 9999;
    overflow: hidden;
    border: 1px solid rgba(250, 250, 247, 0.12);
    border-radius: 0.5rem;
    background: rgba(10, 10, 11, 0.97);
    backdrop-filter: blur(8px);
    box-shadow: 0 8px 40px rgba(0,0,0,0.6);
  }
  .detail-panel.is-open {
    display: block;
  }
  .detail-panel-inner {
    padding: 1rem;
    height: 100%;
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  /* Base (home/office) pins — green */
  .base-pin { outline: none; }
  .base-pin .base-dot { fill: #4ade80; }
  .base-pin .base-ring {
    fill: none;
    stroke: #4ade80;
    stroke-width: 1.5;
    opacity: 0.6;
    transition: opacity 220ms ease, stroke-width 220ms ease;
  }
  .base-pin .base-halo {
    fill: #4ade80;
    opacity: 0;
    transition: opacity 220ms ease;
  }
  .base-pin:hover .base-halo,
  .base-pin:focus-visible .base-halo { opacity: 0.2; }
  .base-pin:hover .base-ring,
  .base-pin:focus-visible .base-ring { opacity: 1; stroke-width: 2; }
  .base-pin.is-active .base-halo { opacity: 0.28; }
  .base-pin.is-active .base-ring { opacity: 1; stroke-width: 2.5; }

  /* Visited-country count overlay */
  .map-count {
    position: absolute;
    top: 0.6rem;
    left: 0.75rem;
    display: flex;
    flex-direction: column;
    line-height: 1;
    pointer-events: none;
    user-select: none;
  }
  .map-count-num {
    font-family: ui-monospace, monospace;
    font-size: 2rem;
    font-weight: 600;
    color: rgba(250, 250, 247, 0.85);
    letter-spacing: -0.02em;
  }
  .map-count-label {
    margin-top: 0.2rem;
    font-family: ui-monospace, monospace;
    font-size: 0.55rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: rgba(250, 250, 247, 0.4);
  }

  /* Discreet hello, world */
  .hello-world {
    position: absolute;
    bottom: 0.45rem;
    left: 0.75rem;
    font-family: ui-monospace, monospace;
    font-size: 0.55rem;
    letter-spacing: 0.1em;
    color: rgba(250, 250, 247, 0.22);
    pointer-events: none;
    user-select: none;
  }

  /* Travel pins */
  .pin { outline: none; }
  .pin .pin-dot { fill: #F5A524; }
  .pin .pin-ring {
    fill: none;
    stroke: #F5A524;
    stroke-width: 1.5;
    opacity: 0.55;
    transition: opacity 220ms ease, stroke-width 220ms ease;
  }
  .pin .pin-halo {
    fill: #F5A524;
    opacity: 0;
    transition: opacity 220ms ease;
  }
  .pin:hover .pin-halo,
  .pin:focus-visible .pin-halo { opacity: 0.18; }
  .pin:hover .pin-ring,
  .pin:focus-visible .pin-ring { opacity: 1; stroke-width: 2; }
  .pin.is-active .pin-halo { opacity: 0.28; }
  .pin.is-active .pin-ring { opacity: 1; stroke-width: 2.5; }
  .pin.is-dimmed { opacity: 0.2; }

  .pin .sparkle {
    fill: #F5A524;
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
  }
  .pin:hover .sparkle,
  .pin:focus-visible .sparkle,
  .pin.is-active .sparkle {
    animation: pin-sparkle 1.6s ease-in-out infinite;
  }
  .pin .sparkle:nth-of-type(2) { animation-delay: 0.15s; }
  .pin .sparkle:nth-of-type(3) { animation-delay: 0.35s; }
  .pin .sparkle:nth-of-type(4) { animation-delay: 0.55s; }
  .pin .sparkle:nth-of-type(5) { animation-delay: 0.75s; }

  @keyframes pin-sparkle {
    0%, 100% { opacity: 0; transform: scale(0.4) translate(0, 0); }
    30% { opacity: 1; transform: scale(1) translate(0, -2px); }
    60% { opacity: 0.6; transform: scale(0.85) translate(0, -4px); }
    80% { opacity: 0; transform: scale(0.4) translate(0, -6px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .pin:hover .sparkle,
    .pin:focus-visible .sparkle,
    .pin.is-active .sparkle { animation: none; opacity: 0.7; }
  }
</style>

<script define:vars={{ continentViewboxes }}>
  const CONTINENT_VBS = continentViewboxes;

  const BASE_VB = { x: 0, y: 0, w: 1000, h: 500 };
  const ZOOM_STEP = 0.90;
  const DOUBLE_TAP_ZOOM_STEP = 0.30;
  const MAX_ZOOM = 8;
  const MIN_ZOOM = 1;

  function initWorldMap(root) {
    const svg = root.querySelector('[data-svg]');
    const container = root.querySelector('[data-map-container]');
    // Panel lives outside the overflow-hidden container in the DOM
    const panel = document.querySelector('[data-detail-panel]');
    if (!svg || !container || !panel) return;

    const closeBtn = panel.querySelector('[data-detail-close]');
    const fields = {
      country: panel.querySelector('[data-detail-country]'),
      continent: panel.querySelector('[data-detail-continent]'),
      capital: panel.querySelector('[data-detail-capital]'),
      capitalPop: panel.querySelector('[data-detail-capital-pop]'),
      countryPop: panel.querySelector('[data-detail-country-pop]'),
      leader: panel.querySelector('[data-detail-leader]'),
      leaderTitle: panel.querySelector('[data-detail-leader-title]'),
      leaderRow: panel.querySelector('[data-detail-leader-row]'),
      cities: panel.querySelector('[data-detail-cities]'),
      trips: panel.querySelector('[data-detail-trips]'),
      last: panel.querySelector('[data-detail-last]'),
      population: panel.querySelector('[data-detail-population]'),
      founded: panel.querySelector('[data-detail-founded]'),
      facts: panel.querySelector('[data-detail-facts]'),
    };

    // ── Viewbox state ──────────────────────────────────────────────
    let vb = { ...BASE_VB };

    function applyVB(v, animate) {
      vb = v;
      if (animate) svg.style.transition = 'all 0ms'; // instant-on then off
      svg.setAttribute('viewBox', `${v.x} ${v.y} ${v.w} ${v.h}`);
    }

    function animateTo(target) {
      const start = { ...vb };
      const dur = 380;
      const t0 = performance.now();
      function ease(t) { return t < 0.5 ? 2*t*t : -1+(4-2*t)*t; }
      function tick(now) {
        const p = Math.min((now - t0) / dur, 1);
        const e = ease(p);
        applyVB({
          x: start.x + (target.x - start.x) * e,
          y: start.y + (target.y - start.y) * e,
          w: start.w + (target.w - start.w) * e,
          h: start.h + (target.h - start.h) * e,
        }, false);
        if (p < 1) requestAnimationFrame(tick);
      }
      requestAnimationFrame(tick);
    }

    function clampVB(v) {
      const minW = BASE_VB.w / MAX_ZOOM;
      const maxW = BASE_VB.w / MIN_ZOOM;
      const w = Math.max(minW, Math.min(maxW, v.w));
      const h = (w / BASE_VB.w) * BASE_VB.h;
      let x = Math.max(0, Math.min(BASE_VB.w - w, v.x));
      let y = Math.max(0, Math.min(BASE_VB.h - h, v.y));
      return { x, y, w, h };
    }

    function zoomAround(cx, cy, factor) {
      const w = Math.max(BASE_VB.w / MAX_ZOOM, Math.min(BASE_VB.w / MIN_ZOOM, vb.w * factor));
      const ratio = w / vb.w;
      const x = cx - (cx - vb.x) * ratio;
      const y = cy - (cy - vb.y) * ratio;
      const h = (w / BASE_VB.w) * BASE_VB.h;
      applyVB(clampVB({ x, y, w, h }), false);
    }

    // Convert container pixel coords to SVG viewBox coords
    function containerToVB(px, py) {
      const rect = container.getBoundingClientRect();
      const scale = Math.min(rect.width / BASE_VB.w, rect.height / BASE_VB.h);
      const renderedW = BASE_VB.w * scale;
      const renderedH = BASE_VB.h * scale;
      const offsetX = (rect.width - renderedW) / 2;
      const offsetY = (rect.height - renderedH) / 2;
      const normX = (px - offsetX) / renderedW;
      const normY = (py - offsetY) / renderedH;
      // In current viewBox terms:
      return {
        x: vb.x + normX * vb.w,
        y: vb.y + normY * vb.h,
      };
    }

    // ── Mouse wheel zoom ───────────────────────────────────────────
    container.addEventListener('wheel', (e) => {
      e.preventDefault();
      const rect = container.getBoundingClientRect();
      const { x: cx, y: cy } = containerToVB(e.clientX - rect.left, e.clientY - rect.top);
      const factor = e.deltaY < 0 ? ZOOM_STEP : 1 / ZOOM_STEP;
      zoomAround(cx, cy, factor);
    }, { passive: false });

    // ── Mouse drag to pan ──────────────────────────────────────────
    let dragStart = null;
    let dragVB = null;

    container.addEventListener('mousedown', (e) => {
      if (e.target.closest('.pin') || e.target.closest('[data-detail-panel]') || e.target.closest('.zoom-btn')) return;
      dragStart = { x: e.clientX, y: e.clientY };
      dragVB = { ...vb };
      container.style.cursor = 'grabbing';
    });

    window.addEventListener('mousemove', (e) => {
      if (!dragStart) return;
      const rect = container.getBoundingClientRect();
      const scale = Math.min(rect.width / BASE_VB.w, rect.height / BASE_VB.h);
      const renderedW = BASE_VB.w * scale;
      const dxPx = e.clientX - dragStart.x;
      const dyPx = e.clientY - dragStart.y;
      const dxVB = -(dxPx / renderedW) * vb.w;
      const dyVB = -(dyPx / renderedW) * vb.w * (BASE_VB.h / BASE_VB.w);
      applyVB(clampVB({ x: dragVB.x + dxVB, y: dragVB.y + dyVB, w: dragVB.w, h: dragVB.h }), false);
    });

    window.addEventListener('mouseup', () => {
      dragStart = null;
      dragVB = null;
      container.style.cursor = '';
    });

    // ── Double-click to zoom in ────────────────────────────────────
    let lastClick = 0;
    container.addEventListener('dblclick', (e) => {
      if (e.target.closest('.pin') || e.target.closest('.base-pin') || e.target.closest('.zoom-btn')) return;
      e.preventDefault();
      const rect = container.getBoundingClientRect();
      const { x: cx, y: cy } = containerToVB(e.clientX - rect.left, e.clientY - rect.top);
      const target = clampVB({
        x: cx - (vb.w * DOUBLE_TAP_ZOOM_STEP) / 2,
        y: cy - (vb.h * DOUBLE_TAP_ZOOM_STEP) / 2,
        w: vb.w * DOUBLE_TAP_ZOOM_STEP,
        h: vb.h * DOUBLE_TAP_ZOOM_STEP,
      });
      animateTo(target);
    });

    // ── Touch: pinch-to-zoom + pan ─────────────────────────────────
    let touches = [];
    let touchVB = null;
    let touchMidVB = null;
    let touchDist = null;

    function touchDist2(a, b) {
      return Math.hypot(a.clientX - b.clientX, a.clientY - b.clientY);
    }
    function touchMid(a, b) {
      return { x: (a.clientX + b.clientX) / 2, y: (a.clientY + b.clientY) / 2 };
    }

    container.addEventListener('touchstart', (e) => {
      touches = Array.from(e.touches);
      touchVB = { ...vb };
      if (touches.length === 2) {
        const rect = container.getBoundingClientRect();
        const mid = touchMid(touches[0], touches[1]);
        touchMidVB = containerToVB(mid.x - rect.left, mid.y - rect.top);
        touchDist = touchDist2(touches[0], touches[1]);
      }
    }, { passive: true });

    container.addEventListener('touchmove', (e) => {
      if (e.touches.length === 2) {
        e.preventDefault();
        const cur = Array.from(e.touches);
        const rect = container.getBoundingClientRect();
        const mid = touchMid(cur[0], cur[1]);
        const midVB = containerToVB(mid.x - rect.left, mid.y - rect.top);
        const dist = touchDist2(cur[0], cur[1]);
        const factor = touchDist / dist;
        const w = Math.max(BASE_VB.w / MAX_ZOOM, Math.min(BASE_VB.w / MIN_ZOOM, touchVB.w * factor));
        const ratio = w / touchVB.w;
        const h = (w / BASE_VB.w) * BASE_VB.h;
        const x = touchMidVB.x - (touchMidVB.x - touchVB.x) * ratio - (midVB.x - touchMidVB.x) * ratio;
        const y = touchMidVB.y - (touchMidVB.y - touchVB.y) * ratio - (midVB.y - touchMidVB.y) * ratio;
        applyVB(clampVB({ x, y, w, h }), false);
      } else if (e.touches.length === 1 && touches.length === 1) {
        const cur = e.touches[0];
        const rect = container.getBoundingClientRect();
        const scale = Math.min(rect.width / BASE_VB.w, rect.height / BASE_VB.h);
        const renderedW = BASE_VB.w * scale;
        const dxPx = cur.clientX - touches[0].clientX;
        const dyPx = cur.clientY - touches[0].clientY;
        const dxVB = -(dxPx / renderedW) * vb.w;
        const dyVB = -(dyPx / renderedW) * vb.w * (BASE_VB.h / BASE_VB.w);
        applyVB(clampVB({ x: touchVB.x + dxVB, y: touchVB.y + dyVB, w: touchVB.w, h: touchVB.h }), false);
      }
    }, { passive: false });

    container.addEventListener('touchend', (e) => {
      touches = Array.from(e.touches);
      if (touches.length < 2) { touchDist = null; touchMidVB = null; }
      touchVB = { ...vb };
    }, { passive: true });

    // ── Zoom buttons ───────────────────────────────────────────────
    root.querySelectorAll('[data-zoom]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const cx = vb.x + vb.w / 2;
        const cy = vb.y + vb.h / 2;
        const action = btn.dataset.zoom;
        if (action === 'in') zoomAround(cx, cy, ZOOM_STEP);
        else if (action === 'out') zoomAround(cx, cy, 1 / ZOOM_STEP);
        else if (action === 'reset') animateTo(BASE_VB);
      });
    });

    // ── Fullscreen (mobile) ────────────────────────────────────────
    const fullscreenRoot = root.closest('[data-fullscreen-root]');
    const fullscreenBtn = root.querySelector('[data-fullscreen-btn]');
    const iconExpand = fullscreenBtn?.querySelector('.fullscreen-icon-expand');
    const iconCompress = fullscreenBtn?.querySelector('.fullscreen-icon-compress');
    const fsTarget = fullscreenRoot || container;

    function isFullscreen() {
      return !!document.fullscreenElement || fsTarget.classList.contains('is-pseudo-fs');
    }

    function updateFullscreenIcon() {
      const isFs = isFullscreen();
      if (iconExpand) iconExpand.style.display = isFs ? 'none' : '';
      if (iconCompress) iconCompress.style.display = isFs ? '' : 'none';
      if (fullscreenBtn) fullscreenBtn.setAttribute('aria-label', isFs ? 'Exit fullscreen' : 'Enter fullscreen');
    }

    // CSS-based fallback for browsers that don't support the Fullscreen API on
    // elements (notably iOS Safari) or reject it (e.g. display:contents roots).
    function enterPseudoFullscreen() {
      fsTarget.classList.add('is-pseudo-fs');
      document.documentElement.classList.add('map-fs-lock');
      updateFullscreenIcon();
      if (activeId) positionPanel();
    }
    function exitPseudoFullscreen() {
      fsTarget.classList.remove('is-pseudo-fs');
      document.documentElement.classList.remove('map-fs-lock');
      updateFullscreenIcon();
      if (activeId) positionPanel();
    }

    fullscreenBtn?.addEventListener('click', () => {
      if (isFullscreen()) {
        if (document.fullscreenElement) document.exitFullscreen().catch(() => {});
        else exitPseudoFullscreen();
        return;
      }
      // Prefer the native Fullscreen API; fall back to pseudo-fullscreen when
      // it's unavailable or the request is rejected.
      const req = fsTarget.requestFullscreen;
      if (typeof req === 'function') {
        req.call(fsTarget).then(() => {
          try { screen.orientation.lock('landscape').catch(() => {}); } catch (_) {}
        }).catch(() => { enterPseudoFullscreen(); });
      } else {
        enterPseudoFullscreen();
      }
    });

    document.addEventListener('fullscreenchange', () => {
      updateFullscreenIcon();
      if (activeId) positionPanel();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && fsTarget.classList.contains('is-pseudo-fs')) exitPseudoFullscreen();
    });

    // ── Continent filter chips ─────────────────────────────────────
    let activeContinent = 'all';

    function setContinent(name) {
      activeContinent = name;
      root.querySelectorAll('.continent-chip').forEach((chip) => {
        chip.classList.toggle('active', chip.dataset.continent === name);
      });

      const pinEls = Array.from(root.querySelectorAll('.pin'));
      if (name === 'all') {
        pinEls.forEach((el) => el.classList.remove('is-dimmed'));
        animateTo(BASE_VB);
      } else {
        pinEls.forEach((el) => {
          const match = el.dataset.continent === name;
          el.classList.toggle('is-dimmed', !match);
        });
        const vbArr = CONTINENT_VBS[name];
        if (vbArr) animateTo({ x: vbArr[0], y: vbArr[1], w: vbArr[2], h: vbArr[3] });
      }
      closePanel();
    }

    root.querySelectorAll('.continent-chip').forEach((chip) => {
      chip.addEventListener('click', () => setContinent(chip.dataset.continent));
    });

    // ── Detail panel ───────────────────────────────────────────────
    const pinEls = Array.from(root.querySelectorAll('.pin'));
    const basePinEls = Array.from(root.querySelectorAll('.base-pin'));
    const allActiveEls = [...pinEls, ...basePinEls];
    let activeId = null;

    function positionPanel() {
      const rect = container.getBoundingClientRect();
      const isFs = !!document.fullscreenElement;
      // In fullscreen landscape, treat as desktop (side panel). Otherwise mobile = bottom sheet.
      const isMobile = !isFs && window.innerWidth < 640;
      if (isMobile) {
        Object.assign(panel.style, {
          left: '0', right: '0', bottom: '0', top: 'auto',
          width: '100%', maxHeight: '60vh',
          borderRadius: '0.75rem 0.75rem 0 0',
          borderLeft: 'none', borderRight: 'none', borderBottom: 'none',
        });
      } else {
        const PANEL_W = 224; // w-56 = 14rem ≈ 224px
        Object.assign(panel.style, {
          top: rect.top + 'px',
          right: (window.innerWidth - rect.right) + 'px',
          bottom: (window.innerHeight - rect.bottom) + 'px',
          left: 'auto', width: PANEL_W + 'px', maxHeight: '',
          borderRadius: '0 0.5rem 0.5rem 0',
          borderLeft: '1px solid rgba(250,250,247,0.12)',
        });
      }
    }

    // Rows that vary by pin type
    const capitalRow = panel.querySelector('[data-detail-capital-row]');
    const capitalPopRow = panel.querySelector('[data-detail-capital-pop-row]');
    const countryPopRow = panel.querySelector('[data-detail-country-pop-row]');
    const citiesRow = panel.querySelector('[data-detail-cities-row]');
    const citiesDt = citiesRow?.querySelector('dt');
    const tripsRow = panel.querySelector('[data-detail-trips-row]');
    const lastRow = panel.querySelector('[data-detail-last-row]');

    function openPanel(pin) {
      const d = pin.dataset;
      const isBase = 'baseId' in d;

      if (isBase) {
        if (fields.country) fields.country.textContent = d.baseLabel ?? '';
        if (fields.continent) fields.continent.textContent = d.baseTagline ?? '';
        // Hide travel-specific rows
        capitalRow?.classList.add('hidden');
        capitalPopRow?.classList.add('hidden');
        countryPopRow?.classList.add('hidden');
        if (fields.leaderRow) fields.leaderRow.classList.add('hidden');
        tripsRow?.classList.add('hidden');
        lastRow?.classList.add('hidden');
        // Show connections
        citiesRow?.classList.remove('hidden');
        if (citiesDt) citiesDt.textContent = 'Roles here';
        if (fields.cities) fields.cities.textContent = d.baseConnections || '—';
        // Show base-specific rows
        const populationRow = panel.querySelector('[data-detail-population-row]');
        const foundedRow = panel.querySelector('[data-detail-founded-row]');
        const factsRow = panel.querySelector('[data-detail-facts-row]');
        populationRow?.classList.remove('hidden');
        foundedRow?.classList.remove('hidden');
        factsRow?.classList.remove('hidden');
        if (fields.population) fields.population.textContent = d.basePopulation || '—';
        if (fields.founded) fields.founded.textContent = d.baseFounded || '—';
        if (fields.facts) fields.facts.textContent = d.baseFacts || '—';
      } else {
        if (fields.country) fields.country.textContent = d.country ?? '';
        if (fields.continent) fields.continent.textContent = d.continent ?? '';
        capitalRow?.classList.remove('hidden');
        capitalPopRow?.classList.remove('hidden');
        countryPopRow?.classList.remove('hidden');
        if (fields.capital) fields.capital.textContent = d.capital || '—';
        if (fields.capitalPop) fields.capitalPop.textContent = d.capitalPop || '—';
        if (fields.countryPop) fields.countryPop.textContent = d.countryPop || '—';
        const hasLeader = d.leader && d.leaderTitle;
        if (fields.leaderRow) fields.leaderRow.classList.toggle('hidden', !hasLeader);
        if (hasLeader) {
          if (fields.leaderTitle) fields.leaderTitle.textContent = d.leaderTitle;
          if (fields.leader) fields.leader.textContent = d.leader;
        }
        citiesRow?.classList.remove('hidden');
        if (citiesDt) citiesDt.textContent = 'Cities visited';
        if (fields.cities) fields.cities.textContent = d.cities || '—';
        tripsRow?.classList.remove('hidden');
        lastRow?.classList.remove('hidden');
        if (fields.trips) fields.trips.textContent = d.tripCount || '—';
        if (fields.last) fields.last.textContent = d.lastVisit || '—';
        // Hide base-specific rows
        panel.querySelector('[data-detail-population-row]')?.classList.add('hidden');
        panel.querySelector('[data-detail-founded-row]')?.classList.add('hidden');
        panel.querySelector('[data-detail-facts-row]')?.classList.add('hidden');
      }

      positionPanel();
      panel.classList.add('is-open');
      allActiveEls.forEach((el) => el.classList.toggle('is-active', el === pin));
      activeId = isBase ? ('base-' + d.baseId) : (d.pinId ?? null);
    }

    function closePanel() {
      panel.classList.remove('is-open');
      allActiveEls.forEach((el) => el.classList.remove('is-active'));
      activeId = null;
    }

    basePinEls.forEach((bp) => {
      bp.addEventListener('click', (e) => {
        e.stopPropagation();
        const id = 'base-' + bp.dataset.baseId;
        if (activeId === id) closePanel();
        else openPanel(bp);
      });
      bp.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          const id = 'base-' + bp.dataset.baseId;
          if (activeId === id) closePanel();
          else openPanel(bp);
        }
      });
    });

    pinEls.forEach((pin) => {
      pin.addEventListener('click', (e) => {
        e.stopPropagation();
        if (activeId === pin.dataset.pinId) closePanel();
        else openPanel(pin);
      });
      pin.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          if (activeId === pin.dataset.pinId) closePanel();
          else openPanel(pin);
        }
      });
    });

    closeBtn?.addEventListener('click', (e) => { e.stopPropagation(); closePanel(); });

    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closePanel(); });

    window.addEventListener('resize', () => {
      if (activeId) positionPanel();
    });

    window.addEventListener('scroll', () => {
      if (activeId) positionPanel();
    }, { passive: true });

    container.addEventListener('click', (e) => {
      if (!e.target.closest('.pin') && !e.target.closest('.base-pin') && !e.target.closest('[data-detail-panel]')) {
        closePanel();
      }
    });
  }

  document.querySelectorAll('[data-world-map]').forEach(initWorldMap);
</script>
