---
import { getCountryPins } from '~/data/travels';
import { CONTINENTS, CONTINENT_VIEWBOXES, type Continent } from '~/data/continents';

const VIEW_W = 1000;
const VIEW_H = 500;

function project(lat: number, lon: number) {
  return {
    x: ((lon + 180) / 360) * VIEW_W,
    y: ((90 - lat) / 180) * VIEW_H,
  };
}

const rawPins = await getCountryPins();
const pins = rawPins.map((p) => {
  const { x, y } = project(p.lat, p.lon);
  return {
    ...p,
    x: x + (p.pinOffsetX ?? 0),
    y: y + (p.pinOffsetY ?? 0),
  };
});

// Count visited countries per continent
const continentCounts: Record<string, number> = {};
for (const p of pins) {
  if (p.continent) {
    continentCounts[p.continent] = (continentCounts[p.continent] ?? 0) + 1;
  }
}

const continentViewboxes = Object.fromEntries(
  CONTINENTS.map((c) => [c, CONTINENT_VIEWBOXES[c]])
);
---

<div class="world-map-wrapper space-y-3" data-world-map>
  <!-- Continent filter chips -->
  <div class="flex flex-wrap gap-2" data-continent-filters>
    <button
      type="button"
      class="continent-chip active"
      data-continent="all"
      data-viewbox=""
    >
      All <span class="chip-count">({pins.length})</span>
    </button>
    {CONTINENTS.map((c) => {
      const count = continentCounts[c] ?? 0;
      const vb = CONTINENT_VIEWBOXES[c];
      return (
        <button
          type="button"
          class="continent-chip"
          data-continent={c}
          data-viewbox={vb.join(',')}
        >
          {c} <span class="chip-count">({count})</span>
        </button>
      );
    })}
  </div>

  <!-- Map container -->
  <div class="map-container relative aspect-[2/1] w-full overflow-hidden rounded-lg border border-paper-50/10 bg-ink-900" data-map-container>
    <svg
      viewBox={`0 0 ${VIEW_W} ${VIEW_H}`}
      preserveAspectRatio="xMidYMid meet"
      class="absolute inset-0 h-full w-full touch-none select-none"
      role="img"
      aria-label="World map highlighting countries James has visited"
      data-svg
    >
      <defs>
        <pattern id="land-dots" width="9" height="9" patternUnits="userSpaceOnUse">
          <circle cx="4.5" cy="4.5" r="1.25" fill="currentColor" />
        </pattern>
      </defs>

      <g class="text-paper-50/45">
        <!-- North America -->
        <path d="M 30,105 C 80,90 140,80 210,82 C 270,84 310,95 335,120 C 345,150 330,180 305,200 C 285,220 260,245 235,265 C 215,278 195,278 175,265 C 150,240 135,210 120,185 C 100,165 80,150 60,135 C 45,125 35,115 30,105 Z" fill="url(#land-dots)" />
        <!-- Greenland -->
        <path d="M 378,32 C 410,25 445,30 460,55 C 467,72 458,85 438,86 C 412,86 388,80 375,68 C 370,55 372,42 378,32 Z" fill="url(#land-dots)" />
        <!-- Central America bridge -->
        <path d="M 230,215 C 250,222 265,232 278,245 C 285,255 282,265 270,265 C 255,260 240,245 228,228 Z" fill="url(#land-dots)" />
        <!-- South America -->
        <path d="M 282,222 C 320,218 360,232 380,272 C 395,308 396,352 386,398 C 372,438 342,460 318,455 C 292,445 280,420 277,385 C 272,355 270,322 272,288 C 274,258 277,235 282,222 Z" fill="url(#land-dots)" />
        <!-- UK / Ireland -->
        <path d="M 448,108 C 458,103 470,108 472,122 C 470,135 460,140 450,135 C 442,128 442,115 448,108 Z" fill="url(#land-dots)" />
        <!-- Europe -->
        <path d="M 470,95 C 510,82 565,82 605,92 C 625,108 620,135 600,155 C 575,168 540,170 510,165 C 485,155 470,138 465,118 C 465,108 467,100 470,95 Z" fill="url(#land-dots)" />
        <!-- Africa -->
        <path d="M 478,168 C 525,165 580,172 615,190 C 640,215 645,250 635,288 C 622,325 605,360 585,392 C 572,415 553,425 535,418 C 512,408 498,382 492,355 C 483,322 480,288 480,255 C 480,222 478,195 478,168 Z" fill="url(#land-dots)" />
        <!-- Arabian Peninsula -->
        <path d="M 605,178 C 635,178 660,195 668,222 C 660,245 632,250 610,240 C 598,222 598,200 605,178 Z" fill="url(#land-dots)" />
        <!-- Sinai + Levant -->
        <path d="M 578,150 L 615,148 L 620,168 L 608,182 L 585,180 Z" fill="url(#land-dots)" />
        <!-- Asia (main) -->
        <path d="M 605,80 C 670,72 745,72 815,80 C 870,88 910,105 925,130 C 928,155 905,175 875,185 C 845,195 810,200 780,210 C 755,220 730,232 705,238 C 680,242 655,240 635,225 C 615,210 600,190 595,165 C 593,135 595,108 605,80 Z" fill="url(#land-dots)" />
        <!-- India peninsula -->
        <path d="M 685,215 C 710,218 728,230 732,252 C 728,272 710,280 695,278 C 680,272 672,255 672,240 C 675,225 680,218 685,215 Z" fill="url(#land-dots)" />
        <!-- SE Asia / Indonesia -->
        <ellipse cx="830" cy="265" rx="22" ry="9" fill="url(#land-dots)" />
        <ellipse cx="868" cy="278" rx="18" ry="7" fill="url(#land-dots)" />
        <ellipse cx="800" cy="248" rx="14" ry="6" fill="url(#land-dots)" />
        <!-- Japan -->
        <path d="M 892,150 C 905,145 915,158 912,175 C 908,188 898,188 892,180 C 888,170 888,158 892,150 Z" fill="url(#land-dots)" />
        <!-- Philippines -->
        <ellipse cx="855" cy="225" rx="9" ry="14" fill="url(#land-dots)" />
        <!-- Australia -->
        <path d="M 812,308 C 838,300 880,300 912,310 C 928,322 932,340 920,358 C 902,375 875,382 850,382 C 825,380 805,370 800,352 C 798,332 803,318 812,308 Z" fill="url(#land-dots)" />
        <!-- New Zealand -->
        <path d="M 932,365 L 944,370 L 944,388 L 935,392 Z" fill="url(#land-dots)" />
        <!-- Antarctica strip -->
        <path d="M 0,458 L 1000,458 L 1000,495 L 0,495 Z" fill="url(#land-dots)" />
        <!-- Alaska -->
        <path d="M 25,105 L 75,95 L 90,118 L 65,128 L 35,122 Z" fill="url(#land-dots)" />
        <!-- Iceland -->
        <ellipse cx="430" cy="98" rx="12" ry="6" fill="url(#land-dots)" />
        <!-- Madagascar -->
        <ellipse cx="645" cy="335" rx="6" ry="16" fill="url(#land-dots)" />
      </g>

      <g class="pins">
        {
          pins.map((pin) => (
            <g
              class="pin cursor-pointer"
              data-pin-id={pin.id}
              data-country={pin.country}
              data-continent={pin.continent}
              data-capital={pin.capital}
              data-capital-pop={pin.capitalPop}
              data-country-pop={pin.countryPop}
              data-leader={pin.curated?.leader ?? ''}
              data-leader-title={pin.curated?.leaderTitle ?? ''}
              data-cities={pin.cities.join(', ')}
              data-trip-count={String(pin.tripCount)}
              data-first-visit={pin.firstVisit}
              data-last-visit={pin.lastVisit}
              data-pin-x={pin.x}
              data-pin-y={pin.y}
              transform={`translate(${pin.x}, ${pin.y})`}
              tabindex="0"
              role="button"
              aria-label={`${pin.country} — click for details`}
            >
              <circle class="pin-halo" r="11" />
              <circle class="pin-ring" r="6" />
              <circle class="pin-dot" r="3" />
              <circle class="sparkle" cx="11" cy="-7" r="1" />
              <circle class="sparkle" cx="-9" cy="-10" r="1.3" />
              <circle class="sparkle" cx="-12" cy="5" r="0.9" />
              <circle class="sparkle" cx="9" cy="10" r="1.1" />
              <circle class="sparkle" cx="0" cy="-13" r="0.8" />
              <title>{pin.country}</title>
            </g>
          ))
        }
      </g>
    </svg>

    <!-- Zoom controls -->
    <div class="zoom-controls absolute bottom-2 right-2 flex flex-col gap-1">
      <button type="button" class="zoom-btn" data-zoom="in" aria-label="Zoom in">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M7 2v10M2 7h10" />
        </svg>
      </button>
      <button type="button" class="zoom-btn" data-zoom="reset" aria-label="Reset view" title="Reset">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 7a4 4 0 1 0 4-4 4 4 0 0 1-4 4" /><path d="M3 3v4h4" />
        </svg>
      </button>
      <button type="button" class="zoom-btn" data-zoom="out" aria-label="Zoom out">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M2 7h10" />
        </svg>
      </button>
    </div>

  </div>
</div>

<!-- Detail panel: fixed-positioned so it escapes overflow-hidden, layered above everything -->
<div
  class="detail-panel"
  data-detail-panel
  role="dialog"
  aria-live="polite"
>
  <div class="detail-panel-inner">
    <div class="flex items-start justify-between gap-2">
      <h3 class="font-display text-base font-semibold leading-tight text-paper-50" data-detail-country></h3>
      <button
        type="button"
        class="-mr-1 -mt-1 shrink-0 rounded p-1 text-paper-50/50 hover:text-accent"
        aria-label="Close"
        data-detail-close
      >
        <svg width="12" height="12" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M2 2 L12 12 M12 2 L2 12" />
        </svg>
      </button>
    </div>
    <p class="mt-0.5 font-mono text-[10px] uppercase tracking-[0.14em] text-accent" data-detail-continent></p>
    <dl class="mt-3 flex flex-col gap-y-2.5 text-xs">
      <div data-detail-capital-row>
        <dt class="font-mono uppercase tracking-[0.14em] text-paper-50/50">Capital</dt>
        <dd class="mt-0.5 text-paper-50" data-detail-capital></dd>
      </div>
      <div data-detail-capital-pop-row>
        <dt class="font-mono uppercase tracking-[0.14em] text-paper-50/50">Capital pop.</dt>
        <dd class="mt-0.5 text-paper-50" data-detail-capital-pop></dd>
      </div>
      <div data-detail-country-pop-row>
        <dt class="font-mono uppercase tracking-[0.14em] text-paper-50/50">Country pop.</dt>
        <dd class="mt-0.5 text-paper-50" data-detail-country-pop></dd>
      </div>
      <div data-detail-leader-row class="hidden">
        <dt class="font-mono uppercase tracking-[0.14em] text-paper-50/50" data-detail-leader-title></dt>
        <dd class="mt-0.5 text-paper-50" data-detail-leader></dd>
      </div>
      <div data-detail-cities-row>
        <dt class="font-mono uppercase tracking-[0.14em] text-paper-50/50">Cities visited</dt>
        <dd class="mt-0.5 text-paper-50" data-detail-cities></dd>
      </div>
      <div data-detail-trips-row>
        <dt class="font-mono uppercase tracking-[0.14em] text-paper-50/50">Trips</dt>
        <dd class="mt-0.5 text-paper-50" data-detail-trips></dd>
      </div>
      <div data-detail-last-row>
        <dt class="font-mono uppercase tracking-[0.14em] text-paper-50/50">Last visit</dt>
        <dd class="mt-0.5 text-paper-50" data-detail-last></dd>
      </div>
    </dl>
  </div>
</div>

<style>
  /* Continent chips */
  .continent-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.25rem 0.65rem;
    border-radius: 9999px;
    border: 1px solid rgba(250, 250, 247, 0.15);
    background: transparent;
    color: rgba(250, 250, 247, 0.55);
    font-family: ui-monospace, monospace;
    font-size: 0.65rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    cursor: pointer;
    transition: color 150ms ease, border-color 150ms ease, background 150ms ease;
  }
  .continent-chip:hover {
    color: rgba(250, 250, 247, 0.9);
    border-color: rgba(250, 250, 247, 0.3);
  }
  .continent-chip.active {
    background: #F5A524;
    border-color: #F5A524;
    color: #0a0a0a;
  }
  .chip-count {
    opacity: 0.7;
  }
  .continent-chip.active .chip-count {
    opacity: 0.8;
  }

  /* Zoom buttons */
  .zoom-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 0.375rem;
    border: 1px solid rgba(250, 250, 247, 0.15);
    background: rgba(10, 10, 11, 0.7);
    color: rgba(250, 250, 247, 0.6);
    backdrop-filter: blur(4px);
    cursor: pointer;
    transition: color 120ms ease, background 120ms ease;
  }
  .zoom-btn:hover {
    color: #F5A524;
    background: rgba(10, 10, 11, 0.9);
  }

  /* Detail panel — fixed positioned, above everything */
  .detail-panel {
    display: none;
    position: fixed;
    z-index: 9999;
    overflow: hidden;
    border: 1px solid rgba(250, 250, 247, 0.12);
    border-radius: 0.5rem;
    background: rgba(10, 10, 11, 0.97);
    backdrop-filter: blur(8px);
    box-shadow: 0 8px 40px rgba(0,0,0,0.6);
  }
  .detail-panel.is-open {
    display: block;
  }
  .detail-panel-inner {
    padding: 1rem;
    height: 100%;
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  /* Pins */
  .pin { outline: none; }
  .pin .pin-dot { fill: #F5A524; }
  .pin .pin-ring {
    fill: none;
    stroke: #F5A524;
    stroke-width: 1.5;
    opacity: 0.55;
    transition: opacity 220ms ease, stroke-width 220ms ease;
  }
  .pin .pin-halo {
    fill: #F5A524;
    opacity: 0;
    transition: opacity 220ms ease;
  }
  .pin:hover .pin-halo,
  .pin:focus-visible .pin-halo { opacity: 0.18; }
  .pin:hover .pin-ring,
  .pin:focus-visible .pin-ring { opacity: 1; stroke-width: 2; }
  .pin.is-active .pin-halo { opacity: 0.28; }
  .pin.is-active .pin-ring { opacity: 1; stroke-width: 2.5; }
  .pin.is-dimmed { opacity: 0.2; }

  .pin .sparkle {
    fill: #F5A524;
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
  }
  .pin:hover .sparkle,
  .pin:focus-visible .sparkle,
  .pin.is-active .sparkle {
    animation: pin-sparkle 1.6s ease-in-out infinite;
  }
  .pin .sparkle:nth-of-type(2) { animation-delay: 0.15s; }
  .pin .sparkle:nth-of-type(3) { animation-delay: 0.35s; }
  .pin .sparkle:nth-of-type(4) { animation-delay: 0.55s; }
  .pin .sparkle:nth-of-type(5) { animation-delay: 0.75s; }

  @keyframes pin-sparkle {
    0%, 100% { opacity: 0; transform: scale(0.4) translate(0, 0); }
    30% { opacity: 1; transform: scale(1) translate(0, -2px); }
    60% { opacity: 0.6; transform: scale(0.85) translate(0, -4px); }
    80% { opacity: 0; transform: scale(0.4) translate(0, -6px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .pin:hover .sparkle,
    .pin:focus-visible .sparkle,
    .pin.is-active .sparkle { animation: none; opacity: 0.7; }
  }
</style>

<script define:vars={{ continentViewboxes }}>
  const CONTINENT_VBS = continentViewboxes;

  const BASE_VB = { x: 0, y: 0, w: 1000, h: 500 };
  const ZOOM_STEP = 0.65;
  const MAX_ZOOM = 8;
  const MIN_ZOOM = 1;

  function initWorldMap(root) {
    const svg = root.querySelector('[data-svg]');
    const container = root.querySelector('[data-map-container]');
    // Panel lives outside the overflow-hidden container in the DOM
    const panel = document.querySelector('[data-detail-panel]');
    if (!svg || !container || !panel) return;

    const closeBtn = panel.querySelector('[data-detail-close]');
    const fields = {
      country: panel.querySelector('[data-detail-country]'),
      continent: panel.querySelector('[data-detail-continent]'),
      capital: panel.querySelector('[data-detail-capital]'),
      capitalPop: panel.querySelector('[data-detail-capital-pop]'),
      countryPop: panel.querySelector('[data-detail-country-pop]'),
      leader: panel.querySelector('[data-detail-leader]'),
      leaderTitle: panel.querySelector('[data-detail-leader-title]'),
      leaderRow: panel.querySelector('[data-detail-leader-row]'),
      cities: panel.querySelector('[data-detail-cities]'),
      trips: panel.querySelector('[data-detail-trips]'),
      last: panel.querySelector('[data-detail-last]'),
    };

    // ── Viewbox state ──────────────────────────────────────────────
    let vb = { ...BASE_VB };

    function applyVB(v, animate) {
      vb = v;
      if (animate) svg.style.transition = 'all 0ms'; // instant-on then off
      svg.setAttribute('viewBox', `${v.x} ${v.y} ${v.w} ${v.h}`);
    }

    function animateTo(target) {
      const start = { ...vb };
      const dur = 380;
      const t0 = performance.now();
      function ease(t) { return t < 0.5 ? 2*t*t : -1+(4-2*t)*t; }
      function tick(now) {
        const p = Math.min((now - t0) / dur, 1);
        const e = ease(p);
        applyVB({
          x: start.x + (target.x - start.x) * e,
          y: start.y + (target.y - start.y) * e,
          w: start.w + (target.w - start.w) * e,
          h: start.h + (target.h - start.h) * e,
        }, false);
        if (p < 1) requestAnimationFrame(tick);
      }
      requestAnimationFrame(tick);
    }

    function clampVB(v) {
      const minW = BASE_VB.w / MAX_ZOOM;
      const maxW = BASE_VB.w / MIN_ZOOM;
      const w = Math.max(minW, Math.min(maxW, v.w));
      const h = (w / BASE_VB.w) * BASE_VB.h;
      let x = Math.max(0, Math.min(BASE_VB.w - w, v.x));
      let y = Math.max(0, Math.min(BASE_VB.h - h, v.y));
      return { x, y, w, h };
    }

    function zoomAround(cx, cy, factor) {
      const w = Math.max(BASE_VB.w / MAX_ZOOM, Math.min(BASE_VB.w / MIN_ZOOM, vb.w * factor));
      const ratio = w / vb.w;
      const x = cx - (cx - vb.x) * ratio;
      const y = cy - (cy - vb.y) * ratio;
      const h = (w / BASE_VB.w) * BASE_VB.h;
      applyVB(clampVB({ x, y, w, h }), false);
    }

    // Convert container pixel coords to SVG viewBox coords
    function containerToVB(px, py) {
      const rect = container.getBoundingClientRect();
      const scale = Math.min(rect.width / BASE_VB.w, rect.height / BASE_VB.h);
      const renderedW = BASE_VB.w * scale;
      const renderedH = BASE_VB.h * scale;
      const offsetX = (rect.width - renderedW) / 2;
      const offsetY = (rect.height - renderedH) / 2;
      const normX = (px - offsetX) / renderedW;
      const normY = (py - offsetY) / renderedH;
      // In current viewBox terms:
      return {
        x: vb.x + normX * vb.w,
        y: vb.y + normY * vb.h,
      };
    }

    // ── Mouse wheel zoom ───────────────────────────────────────────
    container.addEventListener('wheel', (e) => {
      e.preventDefault();
      const rect = container.getBoundingClientRect();
      const { x: cx, y: cy } = containerToVB(e.clientX - rect.left, e.clientY - rect.top);
      const factor = e.deltaY < 0 ? ZOOM_STEP : 1 / ZOOM_STEP;
      zoomAround(cx, cy, factor);
    }, { passive: false });

    // ── Mouse drag to pan ──────────────────────────────────────────
    let dragStart = null;
    let dragVB = null;

    container.addEventListener('mousedown', (e) => {
      if (e.target.closest('.pin') || e.target.closest('[data-detail-panel]') || e.target.closest('.zoom-btn')) return;
      dragStart = { x: e.clientX, y: e.clientY };
      dragVB = { ...vb };
      container.style.cursor = 'grabbing';
    });

    window.addEventListener('mousemove', (e) => {
      if (!dragStart) return;
      const rect = container.getBoundingClientRect();
      const scale = Math.min(rect.width / BASE_VB.w, rect.height / BASE_VB.h);
      const renderedW = BASE_VB.w * scale;
      const dxPx = e.clientX - dragStart.x;
      const dyPx = e.clientY - dragStart.y;
      const dxVB = -(dxPx / renderedW) * vb.w;
      const dyVB = -(dyPx / renderedW) * vb.w * (BASE_VB.h / BASE_VB.w);
      applyVB(clampVB({ x: dragVB.x + dxVB, y: dragVB.y + dyVB, w: dragVB.w, h: dragVB.h }), false);
    });

    window.addEventListener('mouseup', () => {
      dragStart = null;
      dragVB = null;
      container.style.cursor = '';
    });

    // ── Touch: pinch-to-zoom + pan ─────────────────────────────────
    let touches = [];
    let touchVB = null;
    let touchMidVB = null;
    let touchDist = null;

    function touchDist2(a, b) {
      return Math.hypot(a.clientX - b.clientX, a.clientY - b.clientY);
    }
    function touchMid(a, b) {
      return { x: (a.clientX + b.clientX) / 2, y: (a.clientY + b.clientY) / 2 };
    }

    container.addEventListener('touchstart', (e) => {
      touches = Array.from(e.touches);
      touchVB = { ...vb };
      if (touches.length === 2) {
        const rect = container.getBoundingClientRect();
        const mid = touchMid(touches[0], touches[1]);
        touchMidVB = containerToVB(mid.x - rect.left, mid.y - rect.top);
        touchDist = touchDist2(touches[0], touches[1]);
      }
    }, { passive: true });

    container.addEventListener('touchmove', (e) => {
      if (e.touches.length === 2) {
        e.preventDefault();
        const cur = Array.from(e.touches);
        const rect = container.getBoundingClientRect();
        const mid = touchMid(cur[0], cur[1]);
        const midVB = containerToVB(mid.x - rect.left, mid.y - rect.top);
        const dist = touchDist2(cur[0], cur[1]);
        const factor = touchDist / dist;
        const w = Math.max(BASE_VB.w / MAX_ZOOM, Math.min(BASE_VB.w / MIN_ZOOM, touchVB.w * factor));
        const ratio = w / touchVB.w;
        const h = (w / BASE_VB.w) * BASE_VB.h;
        const x = touchMidVB.x - (touchMidVB.x - touchVB.x) * ratio - (midVB.x - touchMidVB.x) * ratio;
        const y = touchMidVB.y - (touchMidVB.y - touchVB.y) * ratio - (midVB.y - touchMidVB.y) * ratio;
        applyVB(clampVB({ x, y, w, h }), false);
      } else if (e.touches.length === 1 && touches.length === 1) {
        const cur = e.touches[0];
        const rect = container.getBoundingClientRect();
        const scale = Math.min(rect.width / BASE_VB.w, rect.height / BASE_VB.h);
        const renderedW = BASE_VB.w * scale;
        const dxPx = cur.clientX - touches[0].clientX;
        const dyPx = cur.clientY - touches[0].clientY;
        const dxVB = -(dxPx / renderedW) * vb.w;
        const dyVB = -(dyPx / renderedW) * vb.w * (BASE_VB.h / BASE_VB.w);
        applyVB(clampVB({ x: touchVB.x + dxVB, y: touchVB.y + dyVB, w: touchVB.w, h: touchVB.h }), false);
      }
    }, { passive: false });

    container.addEventListener('touchend', (e) => {
      touches = Array.from(e.touches);
      if (touches.length < 2) { touchDist = null; touchMidVB = null; }
      touchVB = { ...vb };
    }, { passive: true });

    // ── Zoom buttons ───────────────────────────────────────────────
    root.querySelectorAll('[data-zoom]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const cx = vb.x + vb.w / 2;
        const cy = vb.y + vb.h / 2;
        const action = btn.dataset.zoom;
        if (action === 'in') zoomAround(cx, cy, ZOOM_STEP);
        else if (action === 'out') zoomAround(cx, cy, 1 / ZOOM_STEP);
        else if (action === 'reset') animateTo(BASE_VB);
      });
    });

    // ── Continent filter chips ─────────────────────────────────────
    let activeContinent = 'all';

    function setContinent(name) {
      activeContinent = name;
      root.querySelectorAll('.continent-chip').forEach((chip) => {
        chip.classList.toggle('active', chip.dataset.continent === name);
      });

      const pinEls = Array.from(root.querySelectorAll('.pin'));
      if (name === 'all') {
        pinEls.forEach((el) => el.classList.remove('is-dimmed'));
        animateTo(BASE_VB);
      } else {
        pinEls.forEach((el) => {
          const match = el.dataset.continent === name;
          el.classList.toggle('is-dimmed', !match);
        });
        const vbArr = CONTINENT_VBS[name];
        if (vbArr) animateTo({ x: vbArr[0], y: vbArr[1], w: vbArr[2], h: vbArr[3] });
      }
      closePanel();
    }

    root.querySelectorAll('.continent-chip').forEach((chip) => {
      chip.addEventListener('click', () => setContinent(chip.dataset.continent));
    });

    // ── Detail panel ───────────────────────────────────────────────
    const pinEls = Array.from(root.querySelectorAll('.pin'));
    let activeId = null;

    function positionPanel() {
      const rect = container.getBoundingClientRect();
      const isMobile = window.innerWidth < 640;
      if (isMobile) {
        Object.assign(panel.style, {
          left: '0', right: '0', bottom: '0', top: 'auto',
          width: '100%', maxHeight: '60vh',
          borderRadius: '0.75rem 0.75rem 0 0',
          borderLeft: 'none', borderRight: 'none', borderBottom: 'none',
        });
      } else {
        const PANEL_W = 224; // w-56 = 14rem ≈ 224px
        Object.assign(panel.style, {
          top: rect.top + 'px',
          right: (window.innerWidth - rect.right) + 'px',
          bottom: (window.innerHeight - rect.bottom) + 'px',
          left: 'auto', width: PANEL_W + 'px', maxHeight: '',
          borderRadius: '0 0.5rem 0.5rem 0',
          borderLeft: '1px solid rgba(250,250,247,0.12)',
        });
      }
    }

    function openPanel(pin) {
      const d = pin.dataset;
      if (fields.country) fields.country.textContent = d.country ?? '';
      if (fields.continent) fields.continent.textContent = d.continent ?? '';
      if (fields.capital) fields.capital.textContent = d.capital || '—';
      if (fields.capitalPop) fields.capitalPop.textContent = d.capitalPop || '—';
      if (fields.countryPop) fields.countryPop.textContent = d.countryPop || '—';

      const hasLeader = d.leader && d.leaderTitle;
      if (fields.leaderRow) fields.leaderRow.classList.toggle('hidden', !hasLeader);
      if (hasLeader) {
        if (fields.leaderTitle) fields.leaderTitle.textContent = d.leaderTitle;
        if (fields.leader) fields.leader.textContent = d.leader;
      }

      if (fields.cities) fields.cities.textContent = d.cities || '—';
      if (fields.trips) fields.trips.textContent = d.tripCount || '—';
      if (fields.last) fields.last.textContent = d.lastVisit || '—';

      positionPanel();
      panel.classList.add('is-open');
      pinEls.forEach((el) => el.classList.toggle('is-active', el === pin));
      activeId = pin.dataset.pinId ?? null;
    }

    function closePanel() {
      panel.classList.remove('is-open');
      pinEls.forEach((el) => el.classList.remove('is-active'));
      activeId = null;
    }

    pinEls.forEach((pin) => {
      pin.addEventListener('click', (e) => {
        e.stopPropagation();
        if (activeId === pin.dataset.pinId) closePanel();
        else openPanel(pin);
      });
      pin.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          if (activeId === pin.dataset.pinId) closePanel();
          else openPanel(pin);
        }
      });
    });

    closeBtn?.addEventListener('click', (e) => { e.stopPropagation(); closePanel(); });

    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closePanel(); });

    window.addEventListener('resize', () => {
      if (activeId) positionPanel();
    });

    window.addEventListener('scroll', () => {
      if (activeId) positionPanel();
    }, { passive: true });

    container.addEventListener('click', (e) => {
      if (!e.target.closest('.pin') && !e.target.closest('[data-detail-panel]')) {
        closePanel();
      }
    });
  }

  document.querySelectorAll('[data-world-map]').forEach(initWorldMap);
</script>
