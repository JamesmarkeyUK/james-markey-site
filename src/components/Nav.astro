---
interface Props {
  variant?: 'home' | 'post';
}

const { variant = 'home' } = Astro.props;
---

<header
  class:list={[
    'absolute left-0 right-0 top-0 z-30',
    variant === 'home' ? 'text-paper-50' : 'text-ink-900',
  ]}
>
  <div class="container-wide flex items-center justify-center py-6">
    <span class="font-display text-lg">Hello, World</span>
  </div>
</header>
