---
import { sections, site } from '~/data/site';

interface Props {
  variant?: 'home' | 'post';
}

const { variant = 'home' } = Astro.props;
const linkPrefix = variant === 'home' ? '' : '/';
const homeNavItems = sections.filter((s) => s.id !== 'bio');
---

<header
  class="sticky top-0 z-30 border-b border-ink-950/10 bg-paper-50/85 backdrop-blur-md backdrop-saturate-150"
>
  <div class="container-wide flex h-16 items-center justify-between">
    <a
      href="/"
      class="inline-flex items-center gap-2.5 text-ink-950"
      aria-label={`${site.name} home`}
    >
      <img src="/favicon.svg" alt="" class="h-9 w-9 rounded-lg" width="36" height="36" />
      <span class="text-lg font-extrabold uppercase tracking-[0.06em]">
        James<span class="ml-1.5 text-accent">Markey</span>
      </span>
    </a>

    {
      variant === 'home' ? (
        <nav class="flex items-center gap-4 sm:gap-6" aria-label="Primary">
          {homeNavItems.map((s) => (
            <a
              href={`${linkPrefix}#${s.id}`}
              class="text-[15px] font-medium text-muted-700 transition-colors hover:text-accent"
            >
              {s.label}
            </a>
          ))}
        </nav>
      ) : (
        <a
          href="/"
          class="text-[15px] font-medium text-muted-700 transition-colors hover:text-accent"
        >
          ← Back home
        </a>
      )
    }
  </div>
</header>
