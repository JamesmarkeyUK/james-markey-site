---
import type { Investment } from '~/data/investments';

interface Props {
  investment: Investment;
}

const { investment } = Astro.props;
---

<a
  href={investment.href}
  target="_blank"
  rel="noopener noreferrer"
  class="group flex flex-col gap-4 rounded-lg border border-ink-950/10 bg-paper-50 p-8 transition-colors hover:border-accent"
>
  <div class="flex items-start justify-between">
    {investment.tag && <p class="label-eyebrow text-muted-500">{investment.tag}</p>}
    <span class="text-ink-950/40 transition-all group-hover:translate-x-1 group-hover:text-accent">↗</span>
  </div>
  <h3 class="font-display text-2xl font-semibold leading-tight text-ink-950">
    {investment.company}
  </h3>
  <p class="text-base leading-relaxed text-ink-800">{investment.description}</p>
</a>
