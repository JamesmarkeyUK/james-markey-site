---
import { Image } from 'astro:assets';
import { site } from '~/data/site';
import portrait from '~/assets/portrait.jpg';
---

<section
  id="hero"
  class="relative isolate overflow-hidden bg-ink-950 pb-20 pt-32 text-paper-50 md:pb-32 md:pt-48"
>
  <!-- Mobile: portrait sits in the top-right behind the text -->
  <div class="pointer-events-none absolute inset-0 lg:hidden" aria-hidden="true">
    <div class="absolute right-0 top-0 h-[75%] w-[55%] opacity-40"
         style="mask-image: linear-gradient(to left, black 40%, transparent 100%), linear-gradient(to bottom, black 60%, transparent 100%); mask-composite: intersect; -webkit-mask-image: linear-gradient(to left, black 40%, transparent 100%), linear-gradient(to bottom, black 60%, transparent 100%); -webkit-mask-composite: source-in;">
      <Image
        src={portrait}
        alt=""
        widths={[480]}
        sizes="55vw"
        loading="eager"
        class="h-full w-full object-cover object-top"
      />
    </div>
  </div>

  <div class="container-wide relative">
    <div class="grid items-end gap-12 lg:grid-cols-[1.4fr_1fr]">
      <div>
        <p class="label-eyebrow text-accent">— James Markey</p>
        <h1 class="mt-6 font-display text-hero font-semibold uppercase leading-[0.92] tracking-tight">
          James<br />Markey
        </h1>
        <p class="mt-8 max-w-xl text-xl leading-relaxed text-paper-50/80 md:text-2xl">
          {site.tagline}
        </p>
        <div class="mt-10 flex flex-wrap gap-4">
          <a
            href="#news"
            class="rounded-md bg-accent px-5 py-3 font-mono text-xs uppercase tracking-[0.18em] text-ink-950 transition-colors hover:bg-accent-hover"
          >
            Latest news
          </a>
          <a
            href="#work"
            class="rounded-md border border-paper-50/20 px-5 py-3 font-mono text-xs uppercase tracking-[0.18em] text-paper-50 transition-colors hover:border-accent hover:text-accent"
          >
            Work →
          </a>
        </div>
      </div>

      <!-- Desktop: portrait as a full-opacity grid card -->
      <div class="hidden lg:block">
        <div class="aspect-[4/5] w-full overflow-hidden rounded-lg border border-paper-50/10 bg-ink-900">
          <Image
            src={portrait}
            alt="Portrait of James Markey"
            widths={[480, 800, 1200]}
            sizes="(min-width: 1024px) 40vw, 100vw"
            loading="eager"
            class="h-full w-full object-cover"
          />
        </div>
      </div>
    </div>
  </div>
</section>
