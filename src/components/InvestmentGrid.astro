---
import { investments } from '~/data/investments';
import InvestmentCard from './InvestmentCard.astro';
---

<div data-swipe-hint class="no-scrollbar flex gap-6 overflow-x-auto snap-x snap-mandatory pb-4 md:grid md:grid-cols-3 md:overflow-visible md:pb-0">
  {investments.map((investment) => (
    <div class="snap-start shrink-0 w-[78vw] md:w-auto">
      <InvestmentCard investment={investment} />
    </div>
  ))}
</div>
