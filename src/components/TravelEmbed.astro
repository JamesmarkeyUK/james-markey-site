---
import { site } from '~/data/site';
import WorldMap from '~/components/WorldMap.astro';
---

<div class="grid gap-12 lg:grid-cols-[1fr_1.4fr] lg:items-center">
  <div>
    <p class="font-display text-5xl font-semibold leading-tight text-paper-50 md:text-6xl">
      {site.countryCount}<span class="text-accent">.</span>
    </p>
    <p class="mt-4 text-xl text-paper-50/70">
      Countries and counting — come say <em>hey</em> while I'm travelling.
    </p>
    <p class="mt-3 text-sm text-paper-50/50">
      Tap a pin for a few of the more exotic stops.
    </p>
    <div class="mt-8 flex flex-col gap-3 text-sm">
      <a
        href={site.nomadlistUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 font-mono uppercase tracking-[0.18em] text-paper-50 hover:text-accent"
      >
        <span>View live map on Nomadlist</span>
        <span aria-hidden="true">→</span>
      </a>
      <a
        href={site.managerAbroadUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 font-mono uppercase tracking-[0.18em] text-paper-50 hover:text-accent"
      >
        <span>Read The Manager Abroad blog</span>
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>

  <WorldMap />
</div>
