---
import type { CollectionEntry } from 'astro:content';
import PostCard from './PostCard.astro';

interface Props {
  posts: CollectionEntry<'posts'>[];
  tone?: 'dark' | 'light';
}

const { posts, tone = 'light' } = Astro.props;
---

<div class="no-scrollbar flex gap-8 overflow-x-auto snap-x snap-mandatory pb-4 sm:grid sm:grid-cols-2 sm:overflow-visible sm:pb-0 lg:grid-cols-3">
  {posts.map((post) => (
    <div class="snap-start shrink-0 w-[85vw] sm:w-auto">
      <PostCard post={post} tone={tone} />
    </div>
  ))}
</div>
