{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "james-markey-site",
  "compatibility_date": "2026-05-15",
  "observability": {
    "enabled": true
  },
  "main": "dist/_worker.js/index.js",
  "compatibility_flags": [
    "global_fetch_strictly_public",
    "nodejs_compat"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "dist"
  },
  "routes": [
    { "pattern": "jamesmarkey.co.uk", "custom_domain": true },
    { "pattern": "www.jamesmarkey.co.uk", "custom_domain": true }
  ]
}
